# ---- server ----
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=12h

# ---- database ----
# Point at a local or Atlas MongoDB. If unreachable, the API automatically
# falls back to the JSON document store in server/.data/db.json.
MONGO_URI=mongodb://127.0.0.1:27017/medguard
FORCE_MEMORY=false

# ---- ML service ----
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=20000

# ---- scoring ----
FLAG_THRESHOLD=0.62
W_MODEL=0.6
W_RULES=0.3
W_ANOMALY=0.1
